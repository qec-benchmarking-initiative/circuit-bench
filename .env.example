# Local PostgreSQL settings. These defaults are development credentials only.
POSTGRES_DB=decoderbench
POSTGRES_USER=decoderbench
POSTGRES_PASSWORD=decoderbench_dev
POSTGRES_PORT=5432

# Used by Django when the application scaffold is added.
DATABASE_URL=postgresql://decoderbench:decoderbench_dev@127.0.0.1:5432/decoderbench

