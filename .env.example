# Local PostgreSQL settings. These defaults are development credentials only.
POSTGRES_DB=decoderbench
POSTGRES_USER=decoderbench
POSTGRES_PASSWORD=decoderbench_dev
POSTGRES_PORT=5432

# Used by Django when the application scaffold is added.
DATABASE_URL=postgresql://decoderbench:decoderbench_dev@127.0.0.1:5432/decoderbench
DJANGO_SECRET_KEY=replace-in-production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DEPLOYMENT_ENVIRONMENT=development
ARTIFACT_STORAGE_BACKEND=local

# OAuth provider credentials are optional until account integration is tested.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_BASE_DOMAIN=sandbox.orcid.org

# Required only when ARTIFACT_STORAGE_BACKEND=r2.
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
