{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:circuit-bench:schema:circuit:0.3",
  "title": "Circuit record 0.3",
  "description": "One immutable sampling circuit, generated detector error model, and complete provenance.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "url",
        "sha256",
        "byte_size",
        "media_type"
      ]
    },
    "credit": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "name"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "account_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "account_id"
          ]
        }
      ]
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "paper",
            "source",
            "documentation",
            "artifact",
            "other"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "kind",
        "url",
        "label"
      ]
    },
    "nullablePositiveInteger": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "nullableUuid": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "nullableDateTime": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "tagSlug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 200
    }
  },
