{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:circuit-bench:schema:result:0.4",
  "title": "Result record 0.4",
  "description": "One self-contained Circuit Bench claim over one declared set of attempted shots.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "url",
        "sha256",
        "byte_size",
        "media_type"
      ]
    },
    "nullableArtifact": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/artifact"
        }
      ]
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "source_archive",
            "documentation",
            "configuration",
            "reproduction_bundle",
            "other"
          ]
        },
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        }
      },
      "required": [
        "role",
        "position",
        "artifact"
      ]
    },
    "credit": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "name"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "account_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "account_id"
          ]
        }
      ]
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "paper",
            "source",
            "documentation",
            "artifact",
            "configuration",
            "raw_trace",
            "other"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "kind",
        "url",
        "label"
      ]
    },
    "resultScore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "score_definition_id": {
          "type": "string",
          "format": "uuid"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "definition_url": {
          "type": "string",
          "format": "uri"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "lower_is_better",
            "higher_is_better",
            "not_ranked"
          ]
        },
        "primary_value_kind": {
          "enum": [
            "estimate",
            "lower_bound",
            "upper_bound"
          ]
        },
        "value": {
          "type": "number"
        },
        "point_estimate": {
          "type": [
            "number",
            "null"
          ]
        },
        "lower_bound": {
          "type": [
            "number",
            "null"
          ]
        },
        "upper_bound": {
          "type": [
            "number",
            "null"
          ]
        },
        "confidence_level": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "sample_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "event_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "details": {
          "type": "object"
        }
